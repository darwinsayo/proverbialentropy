---
interface Props {
  title?: string;
}
const { title = "Proverbial Entropy" } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #121212;
            --card-bg: #1a1a1a;
            --text-color: #e0e0e0;
            --text-muted: #9e9e9e;
            --accent-color: #d4af37;
            --border-color: #2a2a2a;
            --font-serif: 'Cormorant Garamond', serif;
            --font-sans: 'Inter', sans-serif;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: var(--font-sans);
            line-height: 1.6;
            padding: 2rem 1rem;
        }
        .container { max-width: 720px; margin: 0 auto; }
        .site-header { margin-bottom: 3rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1.5rem; }
        .site-logo { font-family: var(--font-serif); font-size: 2.5rem; font-weight: 600; color: #fff; text-decoration: none; }
        .site-tagline { color: var(--text-muted); font-size: 1rem; margin-top: 0.5rem; }
        .site-footer { margin-top: 4rem; border-top: 1px solid var(--border-color); padding-top: 1.5rem; text-align: center; color: var(--text-muted); font-size: 0.85rem; }
    </style>
</head>
<body>
    <header class="site-header">
        <div class="container">
            <a href="/" class="site-logo">Proverbial Entropy</a>
            <p class="site-tagline">Internal musings on modern chaos and the preservation of the soul.</p>
        </div>
    </header>
    <main class="container">
        <slot />
    </main>
    <footer class="site-footer container">
        <p>&copy; 2026 Proverbial Entropy.</p>
    </footer>
</body>
</html>
