---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allDispatches = await getCollection('dispatches');
const sortedDispatches = allDispatches.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout>
    <section style="margin-bottom: 3rem; font-size: 1.15rem; font-family: var(--font-serif); color: #d0d0d0;">
        <p>Everything naturally drifts, fragments, and falls apart unless met with deliberate, quiet resistance. This space is a collection of thoughts on societal decay, digital static, and what remains steady within.</p>
    </section>

    <section>
        <h2 style="font-family: var(--font-serif); font-size: 1.8rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;">Dispatches</h2>
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            {sortedDispatches.map(post => (
                <article style="background: var(--card-bg); border: 1px solid var(--border-color); padding: 1.5rem; border-radius: 4px;">
                    <div style="display: flex; justify-content: space-between; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.75rem; text-transform: uppercase;">
                        <span>{new Date(post.data.date).toLocaleDateString()}</span>
                        <span>{post.data.tag}</span>
                    </div>
                    <h3 style="font-family: var(--font-serif); font-size: 1.5rem; margin-bottom: 0.75rem;">
                        <a href={`/${post.slug}`} style="color: #fff; text-decoration: none;">{post.data.title}</a>
                    </h3>
                    <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1rem;">{post.data.description}</p>
                    <a href={`/${post.slug}`} style="color: var(--accent-color); text-decoration: none; font-size: 0.9font-weight: 500;">Read Dispatch &rarr;</a>
                </article>
            ))}
        </div>
    </section>
</BaseLayout>
